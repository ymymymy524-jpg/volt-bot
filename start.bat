@echo off
title MyBot - Discord Bot Launcher
color 0B

REM ==========================================
REM 📂 الانتقال لمجلد الملف الحالي
REM ==========================================
cd /d "%~dp0"
echo 📂 المسار الحالي: %CD%
echo.

echo ========================================
echo        🤖 MyBot Launcher 🤖
echo ========================================
echo.

REM ==========================================
REM 🔧 التحقق من وجود بيئة Python
REM ==========================================
python --version >nul 2>&1
if %errorlevel% neq 0 (
    echo ❌ خطأ: Python غير مثبت على النظام!
    echo 📥 قم بتحميل Python من: https://www.python.org/downloads/
    echo ⚠️ تأكد من تفعيل خيار "Add Python to PATH" أثناء التثبيت
    pause
    exit /b 1
)

echo ✅ تم اكتشاف Python بنجاح
python --version
echo.

REM ==========================================
REM 📦 إنشاء وتفعيل البيئة الافتراضية (venv)
REM ==========================================
if not exist "venv" (
    echo 📦 إنشاء بيئة افتراضية جديدة (venv)...
    python -m venv venv
    echo ✅ تم إنشاء البيئة الافتراضية بنجاح
    echo.
)

echo 🔄 تفعيل البيئة الافتراضية...
call venv\Scripts\activate.bat
echo ✅ تم تفعيل البيئة الافتراضية
echo.

REM ==========================================
REM 📥 تثبيت المتطلبات (requirements.txt)
REM ==========================================
if exist "requirements.txt" (
    echo 📥 جاري التحقق من المتطلبات وتثبيتها...
    pip install -r requirements.txt --quiet
    echo ✅ تم التحقق من المتطلبات
    echo.
)

REM ==========================================
REM 📂 التحقق من وجود ملفات البوت الأساسية
REM ==========================================
if not exist "bot.py" (
    echo ❌ خطأ: ملف bot.py غير موجود!
    echo 📁 تأكد من تشغيل start.bat من المجلد الرئيسي للمشروع
    pause
    exit /b 1
)

if not exist ".env" (
    echo ⚠️ تحذير: ملف .env غير موجود!
    echo 📝 سيتم استخدام القيم الافتراضية
    echo.
)

REM ==========================================
REM 🚀 تشغيل البوت
REM ==========================================
echo ========================================
echo        🚀 بدء تشغيل البوت 🚀
echo ========================================
echo.
echo 💡 لإيقاف البوت، اضغط Ctrl+C
echo.

python bot.py

REM ==========================================
REM 🛑 في حال توقف البوت
REM ==========================================
echo.
echo ========================================
echo        ⚠️ توقف البوت ⚠️
echo ========================================
echo.
echo 💡 إذا توقف البوت بشكل غير متوقع، تحقق من:
echo    1. صحة التوكن في ملف .env
echo    2. اتصالك بالإنترنت
echo    3. رسائل الخطأ في الأعلى
echo.
pause